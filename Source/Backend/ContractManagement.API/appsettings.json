{
  "CustomContractPlaceholders": {
    "Enabled": false,
    "TenantCodes": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "",

    "CentralDatabase": "",

    "TenantDatabaseTemplate": ""
  },

  "CustomerOtp": {
    "Provider": "Fake"
  },
  "AccountRecovery": {
    "Enabled": false,
    "Provider": "Smtp",
    "EncryptionKey": "",
    "TenantFrontendBaseUrl": "",
    "SystemAdminFrontendBaseUrl": ""
  },
  "Email": {
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "Username": "",
      "AppPassword": "",
      "FromAddress": "",
      "TimeoutSeconds": 30
    }
  },

  "MultiTenancy": {
    "HeaderName": "X-Tenant-Code",
    "TenantClaimType": "tenant_code",
    "AllowHeaderFallback": true,
    "DatabasePrefix": "ContractManagement_Tenant_",
    "TemplateConnectionName": "TenantDatabaseTemplate"
  },

  "TemplatePdfRendering": {
    "ExecutablePath": "",
    "TimeoutSeconds": 60,
    "MaxOutputBytes": 26214400
  },

  "PrivateFileStorage": {
    "RootPath": "../private-storage",
    "MinimumFreeSpaceBytes": 1073741824
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "SystemAdminBootstrap": {
    "Enabled": false
  },

  "AllowedHosts": "localhost"
}
